<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/vanilla">

    <include layout="@layout/toolbar"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:text="Nombre de la Marca:"
        android:textSize="18sp"
        android:textColor="@color/blue"
        android:fontFamily="@font/kugile"/>

    <EditText
        android:id="@+id/brand_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:hint="Marca"
        android:background="@null"
        android:textSize="18sp"
        android:textColor="@color/blue"
        android:textColorHint="@color/blueT"
        android:fontFamily="@font/times_new_roman"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="30dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Empresa:"
            android:textColor="@color/blue"
            android:textSize="18sp"
            android:fontFamily="@font/kugile"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Origen:"
            android:textColor="@color/blue"
            android:textSize="18sp"
            android:fontFamily="@font/kugile"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Contacto:"
            android:textColor="@color/blue"
            android:textSize="18sp"
            android:fontFamily="@font/kugile"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp">

        <EditText
            android:id="@+id/company_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Nombre"
            android:background="@null"
            android:textColor="@color/blue"
            android:textColorHint="@color/blueT"
            android:fontFamily="@font/times_new_roman"/>

        <EditText
            android:id="@+id/origin_country"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="País"
            android:background="@null"
            android:textColor="@color/blue"
            android:textColorHint="@color/blueT"
            android:fontFamily="@font/times_new_roman"/>

        <EditText
            android:id="@+id/contact_phone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Teléfono"
            android:background="@null"
            android:textColor="@color/blue"
            android:textColorHint="@color/blueT"
            android:fontFamily="@font/times_new_roman"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="30dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Grano:"
            android:textColor="@color/blue"
            android:textSize="18sp"
            android:fontFamily="@font/kugile"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tostado:"
            android:textColor="@color/blue"
            android:textSize="18sp"
            android:fontFamily="@font/kugile"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Intensidad:"
            android:textColor="@color/blue"
            android:textSize="18sp"
            android:fontFamily="@font/kugile"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp">

        <Spinner
            android:id="@+id/bean_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <Spinner
            android:id="@+id/roast_level"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <Spinner
            android:id="@+id/intensity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="30dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp">

        <TextView
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:text="Presentación:"
            android:textColor="@color/blue"
            android:textSize="18sp"
            android:fontFamily="@font/kugile"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Peso:"
            android:textColor="@color/blue"
            android:textSize="18sp"
            android:fontFamily="@font/kugile"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Precio:"
            android:textColor="@color/blue"
            android:textSize="18sp"
            android:fontFamily="@font/kugile"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp">

        <Spinner
            android:id="@+id/presentation"
            android:layout_width="170dp"
            android:layout_height="wrap_content"/>

        <Spinner
            android:id="@+id/weight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <EditText
            android:id="@+id/price"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="$"
            android:inputType="numberDecimal"
            android:background="@null"
            android:textAlignment="viewEnd"
            android:textColor="@color/blue"
            android:textColorHint="@color/blueT"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="40dp">

        <Button
            android:id="@+id/save_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guardar"
            android:textColor="@color/white"
            android:backgroundTint="@color/blue"/>

        <TextView
            android:layout_width="30dp"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/show_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mostrar"
            android:textColor="@color/white"
            android:backgroundTint="@color/blue"/>
    </LinearLayout>

</LinearLayout>